# ============================================================
# MuthuAI v1.0 — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Required ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Agent Configuration ──────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
AGENT_NAME=CHAMP
LOG_LEVEL=INFO

# ── Optional Search Key (DuckDuckGo used by default) ──────────
SERPAPI_KEY=

# ── TTS Configuration (Phase 1 Voice Quality Upgrade) ────────────
# Tamil voice options: ta-IN-PallaviNeural (Female, default) | ta-IN-ValluvarNeural (Male)
TTS_VOICE_TAMIL=ta-IN-PallaviNeural

# English voice options: en-IN-NeerjaExpressiveNeural (default) | en-IN-NeerjaNeural | en-IN-PrabhatNeural
TTS_VOICE_ENGLISH=en-IN-NeerjaExpressiveNeural

# Rate: +0% = normal | +12% = slightly faster (recommended) | +20% = fast
TTS_RATE=+12%

# Volume: +0% = default
TTS_VOLUME=+0%

# Pitch adjustment in Hz: +0Hz = default
TTS_PITCH=+0Hz

# ── Jarvis Visual HUD Configuration ─────────────────────────
# ── Jarvis Visual HUD — Master flag ──────────────────────────
VISUAL_UI_ENABLED=true

# ── Display Mode Behaviour ────────────────────────────────────
# Show full-screen AI wake-up animation on CHAMP boot
VISUAL_WAKE_FULLSCREEN=true

# Automatically shrink to compact edge mode when a task starts
VISUAL_TASK_COMPACT=true

# Expand back to full-screen when wake word is detected again
VISUAL_RETURN_FULLSCREEN_ON_WAKE=true

# ── Compact Window ────────────────────────────────────────────
# Position: right | left | top | bottom
#           top-right | top-left | bottom-right | bottom-left | center
#           Or manual coordinates: "x,y"  e.g. "1700,850"
VISUAL_COMPACT_POSITION=right

# Compact window size in pixels
VISUAL_COMPACT_WIDTH=200
VISUAL_COMPACT_HEIGHT=200

# ── Performance ───────────────────────────────────────────────
# Frame rate while in full-screen mode (60 for smooth cinematic feel)
VISUAL_FULLSCREEN_FPS=60

# Frame rate while in compact mode (30 saves CPU)
VISUAL_COMPACT_FPS=30

# ── Transition Animation ──────────────────────────────────────
# Duration (seconds) of the fullscreen ↔ compact morph animation
VISUAL_TRANSITION_DURATION=0.7

# ── Appearance ────────────────────────────────────────────────
# Window opacity (0.0 = invisible, 1.0 = fully opaque)
VISUAL_UI_OPACITY=0.95

# Keep window above other applications
VISUAL_UI_ALWAYS_ON_TOP=true

# Visual intensity scale 0.0–1.0 (glow, particles, ring width)
VISUAL_UI_INTENSITY=1.0

# Theme: golden | teal | neon | red
VISUAL_UI_THEME=golden

# Duration of the procedural AI boot/wake-up animation (seconds)
VISUAL_UI_BOOT_DURATION=3.5

# ── Keyboard Shortcuts (in HUD window) ───────────────────────
# ESC  → hide window
# F8   → toggle show / hide
# F11  → manually toggle fullscreen ↔ compact
